# Copy to .env and adjust. Every value is optional; defaults live in src/voice_rag/config.py.

# Ollama server and model tags
VOICE_RAG_OLLAMA_HOST=http://localhost:11434
VOICE_RAG_LLM_MODEL=qwen3:4b-instruct
VOICE_RAG_EMBED_MODEL=nomic-embed-text

# Retrieval
VOICE_RAG_TOP_K=5
VOICE_RAG_MIN_SIMILARITY=0.55

# Generation (deterministic by default)
VOICE_RAG_TEMPERATURE=0
VOICE_RAG_SEED=42
VOICE_RAG_NUM_CTX=1024
VOICE_RAG_NUM_PREDICT=120
# Leave empty to let Ollama pick the thread count
VOICE_RAG_NUM_THREAD=
VOICE_RAG_KEEP_ALIVE=10m

# Text-to-speech
VOICE_RAG_TTS_VOICE=af_heart
VOICE_RAG_TTS_SPEED=1.0

# Paths (relative to the project root)
VOICE_RAG_KB_DIR=kb
VOICE_RAG_INDEX_DIR=.index
VOICE_RAG_AUDIO_DIR=results/audio
